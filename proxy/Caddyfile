# bd-live-proxy: HTTPS termination and FQDN routing for the Celstream BD portal.
# Generated by scripts/deploy.ps1 (do not edit by hand):
#   proxy/tls/active.caddy       TLS for the FQDN site
#       corporate:  tls /certs/portal.crt /certs/portal.key   (required for shared access)
#       interim:    tls internal                              (local validation only)
#   proxy/tls/extra-sites.caddy  interim mode only: a "localhost" site for local checks
#   proxy/auth/active.caddy      empty = VPN/LAN-only; or basic_auth (set-portal-auth.ps1)
{
	admin 127.0.0.1:2019
	# Internal-only portal: never request public ACME certificates, no :80 redirects.
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

(portal) {
	import /etc/caddy/auth/active.caddy
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Non-sensitive worker/run status written by bd-live-worker (remote validation).
	handle /status.json {
		root * /srv/status
		header Cache-Control "no-store"
		file_server
	}
	handle {
		reverse_proxy bd-live-portal:8501
	}
	log {
		output stdout
		format console
	}
}

# Internal FQDN, e.g. bd-poc.celstream-in.com (PORTAL_FQDN in .env).
{$PORTAL_FQDN} {
	import /etc/caddy/tls/active.caddy
	import portal
}

import /etc/caddy/tls/extra-sites.caddy
